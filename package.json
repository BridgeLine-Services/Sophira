{
  "name": "sophira",
  "version": "1.0.0",
  "private": true,
  "description": "Sophira - a private AI academic assistant",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests --max-warnings=107",
    "test": "tsc -p tests/tsconfig.json && node tests-dist/tests/run.js",
    "cap:sync": "cap sync android && cap sync ios",
    "android:build": "SOPHIRA_NATIVE_RELEASE=1 npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "ios:sync": "cap sync ios",
    "desktop:build": "SOPHIRA_NATIVE_RELEASE=1 node scripts/native-url.mjs --write-tauri && tauri build",
    "desktop:dev": "tauri dev",
    "legal:status": "node scripts/legal-status.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "local:test": "node scripts/local-test.mjs",
    "local:test:model": "node scripts/local-model-download.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:env": "node scripts/verify-deployment.mjs --env-only",
    "env:example": "node scripts/gen-env-example.mjs --check",
    "setup": "node scripts/setup.mjs",
    "setup:ai": "node scripts/setup-ai.mjs",
    "verify": "node scripts/verify.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:check": "node scripts/apply-migrations.mjs --check-only",
    "doctor": "node scripts/doctor.mjs",
    "db:bootstrap-sql": "node scripts/gen-bootstrap-sql.mjs",
    "integrations:doctor": "node scripts/integrations-doctor.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@huggingface/transformers": "^4.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "@types/katex": "^0.16.8",
    "@types/pg": "^8.23.1",
    "clsx": "2.1.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "0.371.0",
    "mammoth": "^1.8.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.1",
    "next": "15.5.28",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "20.12.12",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pdf-lib": "^1.17.1",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.4.5"
  },
  "overrides": {
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "fast-glob": "3.3.3",
    "image-size": "2.0.4",
    "postcss": "8.5.29"
  }
}
