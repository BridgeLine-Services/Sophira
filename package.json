{
  "name": "sophira",
  "version": "1.0.0",
  "private": true,
  "description": "Sophira - a private AI academic assistant",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsc -p tests/tsconfig.json && node tests-dist/tests/run.js",
    "cap:sync": "cap sync android && cap sync ios",
    "android:build": "SOPHIRA_NATIVE_RELEASE=1 npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "ios:sync": "cap sync ios",
    "desktop:build": "SOPHIRA_NATIVE_RELEASE=1 node scripts/native-url.mjs --write-tauri && tauri build",
    "desktop:dev": "tauri dev",
    "legal:status": "node scripts/legal-status.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "clsx": "2.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "0.371.0",
    "mammoth": "^1.8.0",
    "mathjs": "^14.0.0",
    "next": "14.2.35",
    "pdf-parse": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss-animate": "1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "20.12.12",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5"
  }
}
