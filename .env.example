# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed to client

# ---- AI provider (OpenAI-compatible) ----
# Leave OPENAI_API_KEY empty to see the graceful "AI not configured" state.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SOPHIRA_MODEL=gpt-4o-mini
# Public base URL of the deployed app (used in invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
