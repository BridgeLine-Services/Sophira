# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed to client

# ---- AI provider — FREE-FIRST, ZERO BILLING BY DEFAULT ----
# Policy: LOCAL (on-device) -> GEMINI FREE TIER -> paid ONLY if explicitly
# allowed. With these defaults, no paid endpoint can ever be called.
AI_PROVIDER=auto
ALLOW_PAID_AI=false
MONTHLY_AI_BUDGET_USD=0
# Preferred remote provider (free tier; server-side only, never in client):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPTIONAL paid fallback — INERT while ALLOW_PAID_AI=false and budget is 0:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SOPHIRA_MODEL=gpt-4o-mini

# Public base URL of the deployed app (used in invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Verified web research (server-side only; keys never reach the browser) ----
# Search provider: "brave" (default), "tavily", or "custom" (Brave-compatible
# endpoint via SEARCH_BASE_URL). Without a key, the research workflow reports
# honestly and never fabricates sources.
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
# Only needed when SEARCH_PROVIDER=custom:
# SEARCH_BASE_URL=https://your-proxy.example/search
