# Sophira environment template - GENERATED from src/config/env.manifest.json
# (npm run env:example checks sync; never hand-edit this file).
# Copy to .env.local for development. For Vercel, set Production/Preview
# values in the dashboard or run: vercel env pull .env.local
# NEVER commit real secrets.

# ---- Supabase (required for auth + database) ----
# Supabase Project Settings -> API. Auto-provisioned by the Vercel Supabase Integration if installed.
# (REQUIRED for a production deployment)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Auto-provisioned by the Vercel Supabase Integration if installed.
# (REQUIRED for a production deployment)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase project URL. Auto-provisioned by the hosting provider's Supabase integration; used server-side (release gate + owner System Health database probe) as the alternative to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# SERVER ONLY - never browser-visible. Auto-provisioned by the Vercel Supabase Integration if installed.
# (REQUIRED for a production deployment)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auto-provisioned by the Vercel Supabase Integration. Enables the fully automatic first-launch database initialization from /setup - no operator step. SERVER ONLY.
POSTGRES_URL=

# Auto-provisioned by the Vercel Supabase Integration. Enables the fully automatic first-launch database initialization from /setup - no operator step. SERVER ONLY.
POSTGRES_URL_NON_POOLING=

# Auto-provisioned by the Vercel Supabase Integration. Enables the fully automatic first-launch database initialization from /setup - no operator step. SERVER ONLY.
POSTGRES_POOLER_URL=

# Auto-provisioned by the Vercel Supabase Integration. Enables the fully automatic first-launch database initialization from /setup - no operator step. SERVER ONLY.
POSTGRES_POOLER_URL_NON_POOLING=

# Auto-provisioned by the Vercel Supabase Integration. Enables the fully automatic first-launch database initialization from /setup - no operator step. SERVER ONLY.
SUPABASE_DB_PASSWORD=

# OPTIONAL, server/CI only. A Supabase personal access token (supabase.com -> Account -> Access Tokens) that powers AUTOMATED MIGRATIONS: the CI migration job and the one-click Repair Setup apply every missing migration. Never browser-visible; never required for the app itself to run.
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

# OPTIONAL. The Supabase project ref (Settings -> API). Companion to SUPABASE_ACCESS_TOKEN for automated migrations.
SUPABASE_PROJECT_REF=your-project-ref

# ---- App identity ----
# Public base URL used in invite links. Set to the production URL for Production, leave the localhost default for local dev. Vercel: also consider System Environment Variable auto-population.
# (REQUIRED for a production deployment)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Microsoft Entra app (client) ID for the Word integration. Create it in Microsoft Entra (Entra ID -> App registrations -> New registration); see docs/WORD_GOOGLE_DOCS_SETUP.md.
MICROSOFT_CLIENT_ID=

# Microsoft Entra app client secret VALUE (not the ID). Create it under the app registration's Certificates & secrets. SECRET: hosting provider environment settings only.
MICROSOFT_CLIENT_SECRET=

# Google Cloud OAuth client ID for the Docs integration. Create it in Google Cloud Console (APIs & Services -> Credentials); see docs/WORD_GOOGLE_DOCS_SETUP.md.
GOOGLE_CLIENT_ID=

# Google Cloud OAuth client secret. Create it with the OAuth client. SECRET: hosting provider environment settings only.
GOOGLE_CLIENT_SECRET=

# ---- AI provider - FREE-FIRST, ZERO BILLING BY DEFAULT ----
# selfhost | local | gemini | openai | auto (default auto = selfhost first, then free-tier Gemini, then paid OpenAI only if explicitly allowed). Self-hosted AI is the default path and needs no key.
AI_PROVIDER=auto

# PREFERRED free-tier provider (server-side only). Get one at aistudio.google.com. With this set and ALLOW_PAID_AI=false, Sophira never spends money.
GEMINI_API_KEY=

# Gemini model id.
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL paid fallback. INERT while ALLOW_PAID_AI=false and MONTHLY_AI_BUDGET_USD=0 - no paid request can ever be sent.
OPENAI_API_KEY=

# OpenAI-compatible endpoint (e.g. a proxy). Only used when paid AI is allowed.
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI model id used when paid AI is allowed.
SOPHIRA_MODEL=gpt-4o-mini

# SAFEGUARD: keep false to guarantee zero AI billing. true = allow the OpenAI fallback.
ALLOW_PAID_AI=false

# SAFEGUARD: hard monthly cap in USD for paid AI. 0 = paid AI can never spend.
MONTHLY_AI_BUDGET_USD=0

# SELF-HOSTED AI (the default path): base URL of an OpenAI-compatible local inference server - Ollama (http://127.0.0.1:11434), llama.cpp server, vLLM, LM Studio. No API key required; nothing leaves your machines. In production, point it at your own inference server over HTTPS (or a private network).
LOCAL_LLM_BASE_URL=

# Model to request from the self-hosted server (ollama pull llama3.1:8b). For image/homework reading use a vision model (e.g. qwen2.5-vl or llava).
LOCAL_LLM_MODEL=llama3.1:8b

# ONLY if your local inference server requires a bearer token. Usually empty - local servers normally need no key. Never expose to the browser.
LOCAL_LLM_API_KEY=

# ---- Search / research (server-side only) ----
# Without a key, the research workflow reports honestly and never fabricates sources.
SEARCH_PROVIDER=brave

# Brave/Tavily key for verified web research.
SEARCH_API_KEY=

# Required only when SEARCH_PROVIDER=custom (Brave-compatible endpoint).
# (required only when SEARCH_PROVIDER=custom)
SEARCH_BASE_URL=https://your-proxy.example/search

# ---- Local development modes (optional) ----
# DEV ONLY: local-first mode. Impossible in production (middleware refuses when NODE_ENV=production).
SOPHIRA_LOCAL_FIRST=false

# Release designation: an offline-only release uses local AI only; the release gate then requires green local-AI evidence instead of remote keys.
SOPHIRA_OFFLINE_ONLY=false

# Set by repo scripts to suppress native CLI notes. Not user configuration.
# SOPHIRA_QUIET: set by repo scripts - not user configuration.

# Set by npm run android:build / desktop:build to switch native-url resolution to release mode. Not user configuration.
# SOPHIRA_NATIVE_RELEASE: set by repo scripts - not user configuration.

# ---- Native / mobile release (GitHub Actions only - never Vercel) ----
# REQUIRED for native/mobile RELEASE builds: the deployed app URL the native shell loads. Validated: must be a real https URL, not a placeholder. Not needed for Vercel web deploys.
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
SOPHIRA_APP_URL=https://sophira.vercel.app

# Native DEV builds: overrides the dev server URL (defaults to NEXT_PUBLIC_SITE_URL).
SOPHIRA_DEV_URL=http://192.168.1.20:3000

# Android release signing - GitHub Actions secret/path only. Never commit keystore files.
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
ANDROID_KEYSTORE_FILE=app-release.keystore

# Base64 keystore uploaded as a GitHub Actions secret for release builds.
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
ANDROID_KEYSTORE_BASE64=

# GitHub Actions secret.
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
ANDROID_KEY_ALIAS=

# GitHub Actions secret.
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
ANDROID_STORE_PASSWORD=

# GitHub Actions secret.
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
ANDROID_KEY_PASSWORD=

# iOS signing certificate (GitHub Actions secret, base64).
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
IOS_P12_BASE64=

# iOS signing certificate password (GitHub Actions secret).
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
IOS_P12_PASSWORD=

# iOS provisioning profile (GitHub Actions secret, base64).
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
IOS_PROVISIONING_PROFILE_BASE64=

# Apple development team id (GitHub Actions secret).
# (only for native/mobile release builds - GitHub Actions secrets, not Vercel)
IOS_TEAM_ID=

# ---- Live testing (only when RUN_LIVE_TESTS=true) ----
# CI/live-gate flag: opt in to tests that call a REAL deployment with REAL credentials.
# (only when RUN_LIVE_TESTS=true)
RUN_LIVE_TESTS=false

# Live-gate target deployment URL.
# (only when RUN_LIVE_TESTS=true)
SOPHIRA_LIVE_APP_URL=https://sophira.vercel.app

# Live tests MUST use a SEPARATE test Supabase project - never the production academic database.
# (only when RUN_LIVE_TESTS=true)
SOPHIRA_TEST_SUPABASE_URL=https://TEST-PROJECT.supabase.co

# Anon key of the TEST project.
# (only when RUN_LIVE_TESTS=true)
SOPHIRA_TEST_ANON_KEY=

# Test account email in the TEST project.
# (only when RUN_LIVE_TESTS=true)
SOPHIRA_TEST_EMAIL=

# Test account password - CI secret, never in the repo.
# (only when RUN_LIVE_TESTS=true)
SOPHIRA_TEST_PASSWORD=

# Second test account id (cross-user isolation checks).
# (only when RUN_LIVE_TESTS=true)
SOPHIRA_TEST_OTHER_ID=

# GitHub Actions secret: URL of the SEPARATE test Supabase project used by the RLS regression suite (never production).
# (only when RUN_LIVE_TESTS=true)
SUPABASE_TEST_URL=https://TEST-PROJECT.supabase.co

# GitHub Actions secret: anon key of the TEST project.
# (only when RUN_LIVE_TESTS=true)
SUPABASE_TEST_ANON_KEY=

# GitHub Actions secret: service-role key of the TEST project.
# (only when RUN_LIVE_TESTS=true)
SUPABASE_TEST_SERVICE_ROLE_KEY=

# OPTIONAL, server-side only. Fine-grained GitHub token (Actions: write, limited to this repository) that lets the Owner Dashboard's 'Start a fresh full check' button dispatch the single scheduled health workflow. Reading results needs no token. Never place the value in chat, files, or client code.
GITHUB_HEALTH_TOKEN=

# ---- undefined ----
# Resend key for automatic invitation emails. Without it the owner shares the link manually (reported honestly).
RESEND_API_KEY=

# Server-side endpoint of any transactional email API that accepts JSON {from,to,subject,html,text}. Used only when RESEND_API_KEY is absent. Absent: owner copies the invitation link.
EMAIL_API_URL=https://api.postmarkapp.com/email

# Server-only credential for EMAIL_API_URL. Never prefixed NEXT_PUBLIC_, never returned by any endpoint.
EMAIL_API_KEY=

# Verified sender for Resend invitation emails. Falls back to EMAIL_FROM, then a default sender.
SOPHIRA_INVITE_FROM_EMAIL=Sophira <invitations@yourdomain.com>

# Verified sender for invitation email. Must be a domain verified with the email provider; defaults are not assumed.
EMAIL_FROM=Sophira <invites@yourdomain.com>

# Twilio account SID for automatic invitation text messages. Absent: SMS is reported as not configured and the copy link is used.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx

# Server-only Twilio auth token. Never prefixed NEXT_PUBLIC_, never logged, never returned by any endpoint.
TWILIO_AUTH_TOKEN=

# SMS-capable Twilio sender in E.164 format. Recipient numbers are normalised to E.164 before sending.
TWILIO_PHONE_NUMBER=+15551234567

# From address for invitation emails (requires a verified domain).
SOPHIRA_INVITE_FROM_EMAIL=

# Reminder: ALLOW_PAID_AI=false + MONTHLY_AI_BUDGET_USD=0 guarantee zero AI billing.
