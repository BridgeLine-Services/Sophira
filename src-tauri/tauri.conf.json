{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sophira",
  "version": "1.0.0",
  "identifier": "com.bridgeline.sophira",
  "build": {},
  "app": {
    "windows": [
      {
        "title": "Sophira",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 832,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}